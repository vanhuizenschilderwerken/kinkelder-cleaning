DirectoryIndex index.html
Options -MultiViews

RewriteEngine On

# Oude home- en index-URL's permanent naar de homepage.
RewriteCond %{THE_REQUEST} \s/+home(?:\.html)?(?:[\s?]) [NC]
RewriteRule ^home(?:\.html)?$ / [R=301,L]

RewriteCond %{THE_REQUEST} \s/+index(?:\.html)?(?:[\s?]) [NC]
RewriteRule ^index(?:\.html)?$ / [R=301,L]

# Verwijder .html uit zichtbare URL's.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:[\s?]) [NC]
RewriteRule ^(.+)\.html$ /$1 [R=301,L,NE]

# Serveer intern het bijbehorende .html-bestand.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

