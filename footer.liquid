<style>
  /* ===== CSS BEGIN: footer.liquid ===== */
  .site-footer,
  .site-footer * {
    box-sizing: border-box;
  }

  .site-footer {
    margin-top: 80px;
    overflow: hidden;
    background: var(--footer-bg);
    color: var(--footer-text);
    font-family: var(--footer-font);
  }

  .site-footer a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease, opacity 0.2s ease;
  }

  .site-footer a:hover {
    color: var(--footer-whatsapp);
  }

.site-footer__wrap {
  width: min(100%, 1320px);
  margin: 0 auto;
  padding: 54px 24px 0;
}

  .site-footer__masthead {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 40px;
    padding-bottom: 38px;
    border-bottom: 1px solid var(--footer-border);
  }

  .site-footer__brand {
    display: inline-flex;
    flex-direction: column;
    gap: 8px;
    width: fit-content;
    color: var(--footer-text);
    font-family: var(--footer-heading-font);
    font-size: clamp(26px, 2.4vw, 38px);
    line-height: 0.92;
    font-weight: 900;
    letter-spacing: -0.04em;
  }

  .site-footer__brand-mark {
    width: 42px;
    height: 42px;
    display: inline-grid;
    place-items: center;
    border-radius: 9px 9px 9px 2px;
    background: linear-gradient(155deg, var(--footer-blue) 0%, #063A5A 52%, #151515 100%);
    color: #fff;
    font-size: 13px;
    letter-spacing: 0.04em;
  }

  .site-footer__mast-actions {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: clamp(14px, 2vw, 26px);
    font-size: 15px;
    font-weight: 700;
  }

  .site-footer__mast-actions > a:not(.site-footer__quote) {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--footer-text);
  }

  .site-footer__mast-actions svg {
    width: 24px;
    height: 24px;
  }

  .site-footer a.site-footer__quote {
    min-height: 58px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 0 10px 0 24px;
    border-radius: 999px;
    background: var(--footer-blue);
    color: #fff;
    font-weight: 900;
    white-space: nowrap;
    box-shadow: 0 16px 30px rgba(0, 163, 224, 0.24);
  }

  #site-footer .site-footer__quote > span:first-child {
    color: #fff !important;
  }

  .site-footer__quote span:last-child {
    width: 44px;
    height: 44px;
    display: inline-grid;
    place-items: center;
    border-radius: 50%;
    background: #fff;
    color: #151515;
    font-size: 20px;
  }

  .site-footer__quote svg {
    width: 21px;
    height: 21px;
    display: block;
  }

  .site-footer__top {
    display: grid;
    grid-template-columns: 1.05fr 1fr 0.95fr;
    gap: clamp(34px, 5vw, 78px);
    padding: 62px 0 56px;
  }

  .site-footer__brand-block h2 {
    margin: 0 0 22px;
    font-family: var(--footer-heading-font);
    font-size: 21px;
    line-height: 1.12;
    font-weight: 900;
    letter-spacing: -0.03em;
  }

  .site-footer__brand-block p,
  .site-footer__contact p {
    max-width: 430px;
    margin: 0 0 22px;
    color: var(--footer-muted);
    font-size: 17px;
    line-height: 1.5;
  }

  .site-footer__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .site-footer__trust span {
    display: inline-flex;
    padding: 8px 10px;
    border: 1px solid rgba(21, 21, 21, 0.1);
    border-radius: 999px;
    background: #fff;
    color: var(--footer-muted);
    font-size: 12px;
    font-weight: 800;
  }

  .site-footer__menus {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 34px;
  }

  .site-footer__menu-block h3,
  .site-footer__contact h2 {
    margin: 0 0 18px;
    color: var(--footer-text);
    font-size: 16px;
    line-height: 1.2;
    font-weight: 900;
  }

  .site-footer__menu-block ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .site-footer__menu-block li {
    margin: 0 0 12px;
  }

  .site-footer__menu-block a,
  .site-footer__contact-links a {
    color: var(--footer-muted);
    font-size: 15px;
    line-height: 1.35;
    font-weight: 700;
  }

  .site-footer__contact {
    padding: 28px;
    border-radius: var(--footer-radius);
    background: var(--footer-card);
    box-shadow: 0 18px 44px rgba(18, 58, 91, 0.08);
  }

  .site-footer__contact-links {
    display: grid;
    gap: 12px;
    margin-bottom: 24px;
  }

  .site-footer__socials {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .site-footer__socials a {
    width: 42px;
    height: 42px;
    display: inline-grid;
    place-items: center;
    border: 1px solid var(--footer-border);
    border-radius: 999px;
    color: var(--footer-text);
  }

  .site-footer__socials svg {
    width: 21px;
    height: 21px;
    display: block;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    margin: 0 -24px;
    padding: 24px;
    background: rgba(255, 255, 255, 0.62);
    color: var(--footer-muted);
    font-size: 14px;
    line-height: 1.4;
  }

  .site-footer__bottom nav {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .site-footer__accordion-button {
    display: none;
  }

  @media (max-width: 980px) {
    .site-footer__wrap {
      padding: 44px 28px 0;
    }

    .site-footer__masthead {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .site-footer__mast-actions {
      justify-self: stretch;
      flex-wrap: wrap;
      justify-content: space-between;
    }

    .site-footer__top {
      grid-template-columns: 1fr;
      padding: 46px 0 42px;
    }

    .site-footer__menus {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .site-footer__bottom {
      margin: 0 -28px;
      padding: 22px 28px;
    }
  }

  @media (max-width: 720px) {
    .site-footer__top {
      gap: 0;
      padding: 34px 0 28px;
    }

    .site-footer__wrap {
      padding: 34px 18px 0;
    }

    .site-footer__masthead {
      padding-bottom: 28px;
    }

    .site-footer__mast-actions {
      display: grid;
      justify-content: stretch;
    }

    .site-footer__quote {
      width: 100%;
      justify-content: space-between;
    }

    .site-footer__brand-block {
      margin-bottom: 28px;
    }

    .site-footer__menus {
      display: block;
      margin: 0 -18px 32px;
      border-top: 1px solid var(--footer-border);
    }

    .site-footer__menu-block {
      border-bottom: 1px solid var(--footer-border);
    }

    .site-footer__accordion-button {
      width: 100%;
      min-height: 48px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border: 0;
      padding: 0 18px;
      background: transparent;
      color: var(--footer-text);
      font: inherit;
      font-size: 15px;
      font-weight: 900;
      cursor: pointer;
    }

    .site-footer__accordion-icon {
      width: 22px;
      height: 22px;
      display: block;
      transition: transform 0.24s ease;
    }

    .site-footer__accordion-button[aria-expanded="true"] .site-footer__accordion-icon {
      transform: rotate(180deg);
    }

    .site-footer__accordion-content {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.28s ease;
    }

    .site-footer__accordion-content h3 {
      display: none;
    }

    .site-footer__accordion-content ul {
      padding: 0 18px 16px;
    }

    .site-footer__contact {
      padding: 20px;
    }

    .site-footer__bottom {
      display: grid;
      margin: 0 -18px;
      padding: 20px 18px;
    }

    .site-footer__bottom nav {
      flex-wrap: wrap;
      gap: 12px 18px;
    }

  }
  /* ===== CSS END: footer.liquid ===== */
</style>

<script>
  (function () {
    function initFooter() {
      var footer = document.querySelector('[data-footer]');
      if (!footer || footer.dataset.initialized === 'true') return;

      footer.dataset.initialized = 'true';

      var year = footer.querySelector('[data-current-year]');
      var buttons = footer.querySelectorAll('.site-footer__accordion-button');

      if (year) year.textContent = new Date().getFullYear();

      buttons.forEach(function (button) {
        button.addEventListener('click', function () {
          var expanded = button.getAttribute('aria-expanded') === 'true';
          var content = button.nextElementSibling;

          button.setAttribute('aria-expanded', expanded ? 'false' : 'true');
          if (!content) return;
          content.style.maxHeight = expanded ? null : content.scrollHeight + 'px';
        });
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 720) {
          buttons.forEach(function (button) {
            var content = button.nextElementSibling;
            button.setAttribute('aria-expanded', 'false');
            if (content) content.style.maxHeight = null;
          });
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initFooter);
    } else {
      initFooter();
    }
  })();
</script>

